{
  "name": "ai4s-workbench",
  "version": "0.1.9",
  "private": true,
  "description": "Open Science Desktop — local-first, model-agnostic AI research workbench for macOS, Windows and Linux.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @ai4s/desktop dev",
    "science:up": "docker compose up -d --build",
    "science:down": "docker compose down",
    "science:logs": "docker compose logs -f --tail=120",
    "mvp:dev": "pnpm science:up && pnpm dev",
    "build": "pnpm --filter @ai4s/desktop build",
    "test": "pnpm --filter @ai4s/desktop test",
    "typecheck": "pnpm --filter @ai4s/desktop typecheck",
    "lint": "pnpm --filter @ai4s/desktop lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.4.0"
}
