{
  "name": "spark-agent",
  "version": "0.2.1",
  "private": true,
  "description": "Spark Agent — a local-first, evidence-first research agent for macOS.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @ai4s/desktop dev",
    "science:up": "bash scripts/dev/start-internal.sh",
    "science:down": "SPARK_AGENT_OPENAI_API_KEY_SECRET= SPARK_AGENT_CORE_TOKEN=cleanup-only docker compose --project-name ${SPARK_AGENT_INTERNAL_COMPOSE_PROJECT:-spark-agent-internal-dev} down --volumes --remove-orphans",
    "science:logs": "SPARK_AGENT_OPENAI_API_KEY_SECRET= SPARK_AGENT_CORE_TOKEN=logs-only docker compose --project-name ${SPARK_AGENT_INTERNAL_COMPOSE_PROJECT:-spark-agent-internal-dev} logs -f --tail=120",
    "model-key:set": "bash scripts/dev/model-keychain.sh set",
    "model-key:status": "bash scripts/dev/model-keychain.sh status",
    "model-key:delete": "bash scripts/dev/model-keychain.sh delete",
    "mvp:dev": "bash scripts/dev/start-internal.sh",
    "build": "pnpm --filter @ai4s/desktop build",
    "lint:desktop": "bash scripts/quality/run-check.sh desktop lint",
    "typecheck:desktop": "bash scripts/quality/run-check.sh desktop typecheck",
    "test:desktop": "bash scripts/quality/run-check.sh desktop test",
    "fmt:rust": "bash scripts/quality/run-check.sh rust fmt",
    "lint:rust": "bash scripts/quality/run-check.sh rust lint",
    "test:rust": "bash scripts/quality/run-check.sh rust test",
    "lint:core": "bash scripts/quality/run-check.sh core lint",
    "typecheck:core": "bash scripts/quality/run-check.sh core typecheck",
    "test:core": "bash scripts/quality/run-check.sh core test",
    "test:agent-eval": "bash scripts/quality/evaluate-agent-v12.sh",
    "lint:runtime": "bash scripts/quality/run-check.sh runtime lint",
    "typecheck:runtime": "bash scripts/quality/run-check.sh runtime typecheck",
    "test:runtime": "bash scripts/quality/run-check.sh runtime test",
    "test:integration": "bash scripts/quality/docker-smoke.sh",
    "test:integration:production": "bash scripts/quality/docker-smoke.sh --production",
    "test:release-assets": "bash scripts/quality/check-release-assets.sh",
    "test:macos-release-gate": "bash scripts/quality/test-macos-release-gate.sh",
    "test:science-supply-chain": "bash scripts/quality/check-release-assets.sh --science-supply-chain-static && python3 scripts/release/science-sbom.py fixtures --root .",
    "release:macos": "bash scripts/release/build-macos.sh",
    "quality": "bash scripts/quality/run-all.sh",
    "test": "pnpm test:desktop",
    "typecheck": "pnpm typecheck:desktop",
    "lint": "pnpm lint:desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.4.0"
}
