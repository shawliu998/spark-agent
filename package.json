{
  "name": "spark-agent",
  "version": "0.1.9",
  "private": true,
  "description": "Spark Agent — a local-first, evidence-first research agent for macOS.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @ai4s/desktop dev",
    "science:up": "bash scripts/dev/start-internal.sh",
    "science:down": "SPARK_AGENT_CORE_TOKEN=cleanup-only docker compose --project-name ${SPARK_AGENT_INTERNAL_COMPOSE_PROJECT:-spark-agent-internal-dev} down --volumes --remove-orphans",
    "science:logs": "SPARK_AGENT_CORE_TOKEN=logs-only docker compose --project-name ${SPARK_AGENT_INTERNAL_COMPOSE_PROJECT:-spark-agent-internal-dev} logs -f --tail=120",
    "mvp:dev": "bash scripts/dev/start-internal.sh",
    "build": "pnpm --filter @ai4s/desktop build",
    "test": "pnpm --filter @ai4s/desktop test",
    "typecheck": "pnpm --filter @ai4s/desktop typecheck",
    "lint": "pnpm --filter @ai4s/desktop lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.4.0"
}
